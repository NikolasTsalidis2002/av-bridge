#!/bin/bash
#SBATCH --job-name=avb-run
#SBATCH --output=logs/run_%j.out
#SBATCH --error=logs/run_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

# --- 1. Environment & Path Definitions ---
PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

# --- 2. Load System Modules ---
# CPU-only: this stage is pure NumPy / sklearn / POT — no GPU needed.
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs results/exp_a results/exp_b results/exp_c

# --- 3. Encoder selection (defaults match the plan's CLIP/CLAP spirit) ---
IMAGE_ENCODER="${IMAGE_ENCODER:-clip-large}"
AUDIO_ENCODER="${AUDIO_ENCODER:-clap-unfused}"

# --- 4. Phase 3-8: anchors + Exp A, B, C-direct, C-transitive sweeps ---
python ./code/run_experiments.py --exp all \
    --image-encoder "$IMAGE_ENCODER" \
    --audio-encoder "$AUDIO_ENCODER"

# --- 5. Phase 9: per-experiment grids, sweep PNGs, comparison tables ---
python ./code/plots.py --exp all --comparison
