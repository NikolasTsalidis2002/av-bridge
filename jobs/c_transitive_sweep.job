#!/bin/bash
#SBATCH --job-name=avb-ctrans
#SBATCH --output=logs/ctrans_%j.out
#SBATCH --error=logs/ctrans_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL
#
# Parametric C-transitive (identity bridge) sweep across arbitrary
# (image, audio) pairs and arbitrary K / alpha grids.
#
# Each pair is one full K x alpha sweep; the per-pair output lands in
# results/exp_c[__<img>__<aud>]/sweep_transitive.csv. The canonical
# pair (no out-suffix) writes to results/exp_c/; every other pair is
# auto-suffixed by encoder names.
#
# Inputs (env vars at submit time -- all optional):
#   PAIRS       : space-separated "img:aud" tokens. Default: canonical
#                  + text-free.
#   K_GRID      : comma-separated K values. Default: 10,20,50,100,160,
#                  200,300,400.
#   ALPHA_GRID  : comma-separated alpha values. Default: 0.0,0.3,0.5,
#                  0.7,0.9.
#
# Examples:
#   # narrow sweep on three pairs, just three Ks and three alphas
#   PAIRS="clip-large:clap-unfused clip-large:mert-330m dinov2-large:clap-unfused" \
#   K_GRID="100,200,300" \
#   ALPHA_GRID="0.3,0.5,0.7" \
#       sbatch jobs/c_transitive_sweep.job
#
#   # full default sweep on one pair only
#   PAIRS="vit-mae-base:mert-95m" sbatch jobs/c_transitive_sweep.job
#
# Cost estimate: each (pair, K, alpha) cell is two FGW solves +
# evaluation. Each cell ~30 s. So full default sweep (8 K x 5 alpha =
# 40 cells) is ~20 minutes per pair.

set -e
set -x

PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs

PAIRS="${PAIRS:-clip-large:clap-unfused dinov2-large:mert-330m}"
K_GRID_ARG=()
ALPHA_GRID_ARG=()
if [[ -n "${K_GRID:-}" ]];     then K_GRID_ARG=(--K-grid "$K_GRID"); fi
if [[ -n "${ALPHA_GRID:-}" ]]; then ALPHA_GRID_ARG=(--alpha-grid "$ALPHA_GRID"); fi

# Defaults used to decide whether to attach an --out-suffix.
DEFAULT_IMG=clip-large
DEFAULT_AUD=clap-unfused

for PAIR in $PAIRS; do
    IMG="${PAIR%%:*}"
    AUD="${PAIR##*:}"
    if [[ -z "$IMG" || -z "$AUD" || "$IMG" == "$PAIR" ]]; then
        echo "[ctrans] malformed pair token: '$PAIR' (expected img:aud)"
        exit 2
    fi

    SUFFIX_ARG=()
    if [[ "$IMG" != "$DEFAULT_IMG" || "$AUD" != "$DEFAULT_AUD" ]]; then
        SUFFIX_ARG=(--out-suffix "__${IMG}__${AUD}")
    fi

    echo "[ctrans] === pair: image=${IMG}  audio=${AUD} ==="
    python code/run_experiments.py --exp c-transitive \
        --image-encoder "$IMG" --audio-encoder "$AUD" \
        "${K_GRID_ARG[@]}" "${ALPHA_GRID_ARG[@]}" "${SUFFIX_ARG[@]}"
done

echo "[ctrans] done"
echo "[ctrans] CSVs written:"
ls -1 results/exp_c*/sweep_transitive.csv 2>/dev/null
