#!/bin/bash
#SBATCH --job-name=avb-qual
#SBATCH --output=logs/qual_%j.out
#SBATCH --error=logs/qual_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

# --- 1. Environment & Path Definitions ---
PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

# --- 2. Load System Modules ---
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs results/qualitative results/qualitative_best

# --- 3. Configuration -----------------------------------------------------
# Override via env vars:
#   N_QUERIES=5 RANDOM_SEED=0 sbatch jobs/qual.job
N_QUERIES="${N_QUERIES:-5}"
RANDOM_SEED="${RANDOM_SEED:-0}"
TOP_K="${QUAL_TOP_K:-3}"
QUERY_TOP_K="${QUAL_QUERY_TOP_K:-1}"
QUERY_TEMP="${QUAL_QUERY_TEMP:-1e-6}"

# --- 4. Cluster-stratified query sample -----------------------------------
# Writes data/qual_query_clips.txt with N_QUERIES clip_ids, one per
# k-means cluster of the audio embeddings.
python code/sample_query_clips.py --n "$N_QUERIES" --seed "$RANDOM_SEED"

# --- 5. Headline comparison plates ----------------------------------------
# 6 methods x N_QUERIES queries x top-1 retrieval, both directions.
python code/qualitative_panel.py \
    --direction image_to_audio \
    --query-file data/qual_query_clips.txt \
    --random-seed "$RANDOM_SEED" \
    --out results/qualitative_best/panel_i2a_top1.png

python code/qualitative_panel.py \
    --direction audio_to_image \
    --query-file data/qual_query_clips.txt \
    --random-seed "$RANDOM_SEED" \
    --out results/qualitative_best/panel_a2i_top1.png

# --- 6. Per-clip per-method detail figures --------------------------------
# Existing layout: top-K retrievals in both directions, with method label.
# One figure per (query_clip, method) combination.
declare -a METHODS_LABEL=(
    "FGW with caption cost"
    "Text-bridged plan composition"
    "Ridge-supervised FGW"
    "GW (intra-modal geometry alone)"
    "Raw caption cosine"
)
declare -a METHODS_PLAN=(
    "results/exp_d/T_caption.npy"
    "results/exp_c/T_transitive.npy"
    "results/exp_c/T_cdirect.npy"
    "results/exp_unsup/T_gw.npy"
    "results/exp_text/T_text.npy"
)
declare -a METHODS_SHORT=(
    "fgw-cap"
    "text-bridge"
    "ridge-sup"
    "gw"
    "cap-cos"
)

OUT_DIR="results/qualitative_best/detail"
mkdir -p "$OUT_DIR"

while IFS= read -r CID; do
    [[ -z "$CID" ]] && continue
    for i in "${!METHODS_LABEL[@]}"; do
        label="${METHODS_LABEL[$i]}"
        plan="${METHODS_PLAN[$i]}"
        short="${METHODS_SHORT[$i]}"
        if [[ ! -f "$plan" ]]; then
            echo "[skip] $plan missing"
            continue
        fi
        out_png="$OUT_DIR/${CID}__${short}.png"
        python code/qualitative.py \
            --clip-id "$CID" \
            --plan "$plan" \
            --method-label "$label" \
            --top-k "$TOP_K" \
            --query-top-k "$QUERY_TOP_K" \
            --query-temp "$QUERY_TEMP" \
            --out "$out_png"
    done
    # Random baseline figure for this clip.
    out_png="$OUT_DIR/${CID}__random.png"
    python code/qualitative.py \
        --clip-id "$CID" \
        --random-plan permutation \
        --random-seed "$RANDOM_SEED" \
        --method-label "Random permutation (chance baseline)" \
        --top-k "$TOP_K" \
        --query-top-k "$QUERY_TOP_K" \
        --query-temp "$QUERY_TEMP" \
        --out "$out_png"
done < data/qual_query_clips.txt

echo "[qual] all artefacts under results/qualitative_best/"
ls -1 results/qualitative_best/panel_*.png
echo "[qual] detail figures:"
ls -1 "$OUT_DIR"/*.png | head -20
