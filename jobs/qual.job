#!/bin/bash
#SBATCH --job-name=avb-qual
#SBATCH --output=logs/qual_%j.out
#SBATCH --error=logs/qual_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=00:30:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

# --- 1. Environment & Path Definitions ---
PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

# --- 2. Load System Modules ---
# CPU-only: matplotlib + librosa + numpy, no GPU needed.
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs results/qualitative

# --- 3. Clips and plans to render --------------------------------------
# Default: a small representative set. Override either via env var:
#   QUAL_CLIPS="cid1,cid2,..."  sbatch jobs/qual.job
#   QUAL_PLANS="results/exp_d/T_caption.npy,results/exp_c/T_transitive.npy" \
#       sbatch jobs/qual.job
CLIPS="${QUAL_CLIPS:-10001787725,4963357278,5511691883,10095741516,4967363921}"
PLANS="${QUAL_PLANS:-results/exp_d/T_caption.npy,results/exp_c/T_transitive.npy,results/exp_unsup/T_gw.npy,results/exp_text/T_text.npy}"

# Inference hyperparameters; strict-argmax by default (matches R@k semantics).
QUERY_TOP_K="${QUAL_QUERY_TOP_K:-1}"
QUERY_TEMP="${QUAL_QUERY_TEMP:-1e-6}"
TOP_K="${QUAL_TOP_K:-3}"

IFS=',' read -ra CLIP_ARR <<< "$CLIPS"
IFS=',' read -ra PLAN_ARR <<< "$PLANS"

# --- 4. Generate one figure per (clip, plan) pair -----------------------
for cid in "${CLIP_ARR[@]}"; do
    for plan in "${PLAN_ARR[@]}"; do
        if [[ -f "$plan" ]]; then
            python code/qualitative.py \
                --clip-id "$cid" \
                --plan "$plan" \
                --top-k "$TOP_K" \
                --query-top-k "$QUERY_TOP_K" \
                --query-temp "$QUERY_TEMP"
        else
            echo "[skip] missing plan: $plan"
        fi
    done
done

# --- 5. Random-baseline figure for every clip ----------------------------
# Chance-level visual control: a single random permutation (fixed seed) is
# reused across all query clips so the reader can compare any learned plan
# above against the same random matching. Disable by setting RANDOM_BASELINE="".
RANDOM_BASELINE="${RANDOM_BASELINE:-permutation}"
RANDOM_SEED="${RANDOM_SEED:-0}"
if [[ -n "$RANDOM_BASELINE" ]]; then
    for cid in "${CLIP_ARR[@]}"; do
        python code/qualitative.py \
            --clip-id "$cid" \
            --random-plan "$RANDOM_BASELINE" \
            --random-seed "$RANDOM_SEED" \
            --top-k "$TOP_K" \
            --query-top-k "$QUERY_TOP_K" \
            --query-temp "$QUERY_TEMP"
    done
fi

echo "[qual] all figures written to results/qualitative/"
