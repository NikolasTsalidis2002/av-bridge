#!/bin/bash
#SBATCH --job-name=avb-encode
#SBATCH --output=logs/encode_%j.out
#SBATCH --error=logs/encode_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --partition=acltr
#SBATCH --gres=gpu:1
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

# --- 1. Environment & Path Definitions ---
PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

# --- 2. Load System Modules ---
module load CUDA/12.1.1
module load NCCL/2.18.3-GCCcore-12.3.0-CUDA-12.1.1
module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs embeddings

# --- 3. Phase 1: frame + audio extraction (idempotent; skips existing files) ---
python ./code/prepare_data.py

# --- 4. Phase 2: encode all vision + audio + text combos ---
#   Outputs: embeddings/vision_*.npy, embeddings/audio_*.npy,
#            embeddings/ZV_text.npy, embeddings/ZA_text.npy
#
# To restrict to a subset, set ENCODERS, e.g.:
#   ENCODERS="clip-large,clap-unfused" sbatch jobs/encode.job
if [[ -n "${ENCODERS:-}" ]]; then
    python ./code/encode.py --encoders "$ENCODERS"
    python ./code/encode.py --only-text
else
    python ./code/encode.py
fi
