#!/bin/bash
#SBATCH --job-name=avb-analyse
#SBATCH --output=logs/analyse_%j.out
#SBATCH --error=logs/analyse_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs

# Geometric similarity between every image/audio encoder pair.
# Outputs: cka_heatmap.png, identity_pearson_heatmap.png,
#          geometric_similarity.csv
python code/analyse_geometry.py

# Empirical CDF of GT-partner rank under each saved plan.
# Outputs: rank_distribution.png, rank_distributions.csv
python code/analyse_ranks.py

# Multi-granularity AMI and category-recall@K: answers ``do the recipes
# retrieve semantically meaningful information at coarser abstraction
# levels even when instance retrieval fails?''
# Outputs: levels_ami_vs_kcl.png, levels_category_recall_at_k.png,
#          levels_ami.csv, levels_category_recall.csv
python code/analyse_levels.py

echo "[done] analysis figures written to results/exp_grid/plots/"
ls -1 results/exp_grid/plots/cka_heatmap.png \
      results/exp_grid/plots/identity_pearson_heatmap.png \
      results/exp_grid/plots/rank_distribution.png \
      results/exp_grid/plots/levels_ami_vs_kcl.png \
      results/exp_grid/plots/levels_category_recall_at_k.png \
      2>/dev/null || true
