#!/bin/bash
#SBATCH --job-name=avb-multi-pair
#SBATCH --output=logs/multi_pair_%j.out
#SBATCH --error=logs/multi_pair_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --partition=scavenge
#SBATCH --mail-user=edlu@itu.dk
#SBATCH --mail-type=FAIL

set -e
set -x

PROJECT_DIR="$HOME/av-bridge"
ENV_PATH="/home/edlu/miniconda3-25-5-1-1/envs/gwot"

module load Miniconda3/25.5.1-1
source /opt/itu/easybuild/software/Miniconda3/25.5.1-1/etc/profile.d/conda.sh
conda activate "$ENV_PATH"
cd "$PROJECT_DIR"
mkdir -p logs

# --- Configuration -----------------------------------------------------
# The second reference encoder pair: text-free on both sides. Provides
# the cleanest unsupervised-claim evidence (no encoder--text alignment
# to exploit).
IMG_ENC="${IMG_ENC:-dinov2-large}"
AUD_ENC="${AUD_ENC:-mert-330m}"
SUFFIX="__${IMG_ENC}__${AUD_ENC}"

echo "[multi-pair] fitting at image=${IMG_ENC}  audio=${AUD_ENC}"
echo "[multi-pair] artefacts will land under exp_*${SUFFIX}/"

# --- 1. Within-modality A and B (needed for C-transitive composition) -
# These already auto-suffix by encoder; no --out-suffix flag required.
python code/run_experiments.py --exp a --image-encoder "$IMG_ENC"
python code/run_experiments.py --exp b --audio-encoder "$AUD_ENC"

# --- 2. Four cross-modal recipes at the new pair ----------------------
# Pass --out-suffix so saved plans land in suffixed directories instead
# of overwriting the canonical-pair artefacts.
for EXP in c-direct c-transitive d unsup text; do
    python code/run_experiments.py --exp "$EXP" \
        --image-encoder "$IMG_ENC" \
        --audio-encoder "$AUD_ENC" \
        --out-suffix "$SUFFIX"
done

# --- 3. Inventory ------------------------------------------------------
echo "[multi-pair] saved plans:"
ls -1 results/exp_*"${SUFFIX}"/*.npy 2>/dev/null || true
echo "[multi-pair] saved CSVs:"
ls -1 results/exp_*"${SUFFIX}"/*.csv 2>/dev/null || true
